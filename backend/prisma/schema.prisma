generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  PROBATION
  SUSPENDED
  TERMINATED
  RESIGNED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum EmployeeSkillSource {
  SELF_REPORTED
  MANAGER
  HR
  SYSTEM
  CERTIFICATION
}

enum TimelineEventType {
  HIRED
  PROMOTION
  DEPARTMENT_CHANGE
  MANAGER_CHANGE
  SALARY_CHANGE
  LEAVE
  TRAINING
  PERFORMANCE_REVIEW
  DOCUMENT
  OTHER
}

enum DocumentVisibility {
  HR_ONLY
  MANAGER
  EMPLOYEE
  ORGANIZATION
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SalaryComponentType {
  EARNING
  DEDUCTION
}

enum SalaryComponentCategory {
  BASIC
  ALLOWANCE
  BONUS
  COMMISSION
  OVERTIME
  TAX
  LOAN
  UNPAID_LEAVE
  OTHER_DEDUCTION
}

enum SalaryCalculationMethod {
  FIXED
  PERCENTAGE_OF_BASE
  PERCENTAGE_OF_GROSS
  PER_DAY
  PER_HOUR
  ATTENDANCE_DERIVED
}

enum PayrollPeriodStatus {
  DRAFT
  PROCESSING
  REVIEW
  APPROVED
  PAID
  LOCKED
}

enum EmployeeLoanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RecruitmentJobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

enum CandidatePipelineStage {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
  TECHNICAL
  HR
  OTHER
}

enum AiMatchRecommendation {
  STRONG_MATCH
  POTENTIAL_MATCH
  WEAK_MATCH
}

enum RecruitmentEmailTemplateKind {
  INTERVIEW_INVITATION
  REJECTION
  OFFER
  GENERAL
}

enum CandidateDocumentKind {
  CV
  COVER_LETTER
  OTHER
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum OnboardingTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum OnboardingTaskKind {
  DOCUMENTS
  TRAINING
  MANAGER_MEETING
  EQUIPMENT
  GOALS
  COMPLIANCE
}

enum LessonContentType {
  TEXT
  VIDEO
  DOCUMENT
}

enum AssessmentQuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum CertificateStatus {
  ACTIVE
  EXPIRING
  EXPIRED
}

enum PerformanceCycleStatus {
  DRAFT
  ACTIVE
  REVIEW
  FINALIZED
}

enum GoalStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PerformanceReviewStatus {
  PENDING
  MANAGER_REVIEW
  EMPLOYEE_ACK
  FINALIZED
}

enum WorkforceRiskCategory {
  ATTENDANCE
  OVERTIME
  PERFORMANCE
  TRAINING
  PAYROLL
  SKILLS
  WORKLOAD
}

enum WorkforceRiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CopilotMode {
  HR
  MANAGER
  EMPLOYEE
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AiToolCallStatus {
  PENDING
  SUCCESS
  FAILED
  REQUIRES_CONFIRMATION
}

enum AiActionStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXECUTED
  FAILED
}

enum RecommendationType {
  ATTENDANCE
  PAYROLL
  PERFORMANCE
  TRAINING
  SKILLS
  RECRUITMENT
  WORKFORCE
}

enum RecommendationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecommendationStatus {
  OPEN
  APPROVED
  DISMISSED
  EXECUTED
  EXPIRED
}

enum RecommendationActionStatus {
  PENDING
  APPROVED
  DISMISSED
  COMPLETED
  FAILED
}

enum AutomationActorType {
  USER
  SYSTEM
  AI
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum UsageMetricCode {
  ACTIVE_EMPLOYEES
  RECRUITMENT_CANDIDATES
  AI_REQUESTS
  STORAGE_BYTES
  TRAINING_USERS
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships             OrganizationMember[]
  refreshTokens           RefreshToken[]
  authTokens              AuthToken[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  sentInvitations         OrganizationInvitation[] @relation("InvitationInviter")
  acceptedInvitation      OrganizationInvitation?  @relation("InvitationAcceptedUser")
  uploadedEmployeeDocs    EmployeeDocument[]       @relation("DocumentUploader")
  createdTimelineEvents   EmployeeTimelineEvent[]  @relation("TimelineCreator")
  aiConversations         AiConversation[]
  notifications           Notification[]
  recommendationFeedbacks RecommendationFeedback[]
  recommendationActionsResolved RecommendationAction[] @relation("RecommendationActionResolver")

  @@map("users")
}

model Organization {
  id             String   @id @default(cuid())
  name           String
  legalName      String?
  slug           String   @unique
  logoUrl        String?
  website        String?
  industry       String?
  companySize    String?
  country        String?
  timezone       String   @default("UTC")
  currency       String   @default("USD")
  primaryContact String?
  settings       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members       OrganizationMember[]
  invitations   OrganizationInvitation[]
  auditLogs     AuditLog[]
  departments   Department[]
  teams         Team[]
  jobTitles     JobTitle[]
  positions     Position[]
  employees     Employee[]
  skillCategories        SkillCategory[]
  skills                 Skill[]
  employeeTimelineEvents EmployeeTimelineEvent[]
  employeeDocuments      EmployeeDocument[]
  shiftTemplates         ShiftTemplate[]
  employeeShiftAssignments EmployeeShiftAssignment[]
  attendanceRecords      AttendanceRecord[]
  attendanceCorrections  AttendanceCorrection[]
  leaveTypes             LeaveType[]
  leavePolicies          LeavePolicy[]
  leaveBalances          LeaveBalance[]
  leaveRequests          LeaveRequest[]
  salaryStructures       SalaryStructure[]
  salaryComponents       SalaryComponent[]
  employeeSalaries       EmployeeSalary[]
  payrollPeriods         PayrollPeriod[]
  payrollRuns            PayrollRun[]
  payrollItems           PayrollItem[]
  payrollAdjustments     PayrollAdjustment[]
  payslips               Payslip[]
  employeeLoans          EmployeeLoan[]
  recruitmentJobs        RecruitmentJob[]
  candidates             Candidate[]
  jobApplications        JobApplication[]
  candidateDocuments     CandidateDocument[]
  interviews             Interview[]
  candidateNotes         CandidateNote[]
  candidateStageEvents   CandidateStageEvent[]
  aiCandidateEvaluations AiCandidateEvaluation[]
  aiScreeningAudits      AiScreeningAudit[]
  recruitmentEmailTemplates RecruitmentEmailTemplate[]
  onboardingRecords      OnboardingRecord[]
  onboardingTemplates    OnboardingTemplate[]
  onboardingPlans        OnboardingPlan[]
  courses                Course[]
  learningPaths          LearningPath[]
  trainingAssignments    TrainingAssignment[]
  employeeEnrollments    EmployeeEnrollment[]
  trainingCertificates   TrainingCertificate[]
  performanceCycles      PerformanceCycle[]
  goals                  Goal[]
  kpis                   Kpi[]
  performanceReviews     PerformanceReview[]
  competencies           Competency[]
  performanceFeedbacks   PerformanceFeedback[]
  developmentPlans       DevelopmentPlan[]
  workforceInsightSnapshots WorkforceInsightSnapshot[]
  assessments            Assessment[]
  assessmentAttempts     AssessmentAttempt[]
  roleSkillRequirements  RoleSkillRequirement[]
  employeeSkillAssessments EmployeeSkillAssessment[]
  skillGaps                SkillGap[]
  workforceRisks           WorkforceRisk[]
  workforceInsights        WorkforceInsight[]
  aiModels                 AiModel[]
  aiTools                  AiTool[]
  aiConversations          AiConversation[]
  aiRecommendations        AiRecommendation[]
  aiActions                AiAction[]
  aiAuditLogs              AiAuditLog[]
  recommendationRules      RecommendationRule[]
  recommendations          Recommendation[]
  recommendationActions    RecommendationAction[]
  recommendationFeedbacks  RecommendationFeedback[]
  automationRules          AutomationRule[]
  automationAuditLogs      AutomationAuditLog[]
  notifications            Notification[]
  subscriptions            Subscription[]
  usageRecords               UsageRecord[]
  invoices                   Invoice[]

  @@map("organizations")
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  members     OrganizationMember[]
  invitations OrganizationInvitation[]

  @@map("roles")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  employee     Employee?

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Department {
  id                  String   @id @default(cuid())
  organizationId      String
  name                String
  code                String?
  description         String?
  managerEmployeeId   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager      Employee?    @relation("DepartmentManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  teams        Team[]
  positions    Position[]
  employees    Employee[]
  recruitmentJobs RecruitmentJob[]
  onboardingTemplates OnboardingTemplate[]
  trainingAssignments TrainingAssignment[]
  workforceRisks      WorkforceRisk[]
  workforceInsights   WorkforceInsight[]
  recommendations     Recommendation[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@map("departments")
}

model Team {
  id                String   @id @default(cuid())
  organizationId    String
  departmentId      String
  name              String
  description       String?
  leadEmployeeId    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  lead         Employee?    @relation("TeamLead", fields: [leadEmployeeId], references: [id], onDelete: SetNull)
  positions    Position[]
  employees    Employee[]

  @@unique([departmentId, name])
  @@index([organizationId])
  @@map("teams")
}

model JobTitle {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  level          String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  positions    Position[]
  employees    Employee[]
  roleSkillRequirements RoleSkillRequirement[]

  @@unique([organizationId, title])
  @@map("job_titles")
}

model Position {
  id             String   @id @default(cuid())
  organizationId String
  jobTitleId     String
  departmentId   String
  teamId         String?
  code           String?
  isOpen         Boolean  @default(true)
  employeeId     String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobTitle     JobTitle     @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("positions")
}

model Employee {
  id               String           @id @default(cuid())
  organizationId   String
  employeeNumber   String
  userId           String?
  membershipId     String?          @unique
  firstName        String
  lastName         String
  preferredName    String?
  email            String
  phone            String?
  profilePhotoUrl  String?
  dateOfBirth      DateTime?
  jobTitleId       String?
  departmentId     String?
  teamId           String?
  managerId        String?
  employmentType   EmploymentType   @default(FULL_TIME)
  employmentStatus EmploymentStatus @default(ACTIVE)
  joinDate         DateTime?
  probationEndDate DateTime?
  workLocation     String?
  address          Json?
  emergencyContact Json?
  bio              String?
  certifications   Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMember?   @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  jobTitle     JobTitle?             @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  department   Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team         Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  position     Position?
  manager      Employee?             @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports Employee[]           @relation("EmployeeManager")
  managedDepartments Department[]    @relation("DepartmentManager")
  ledTeams     Team[]                @relation("TeamLead")
  timelineEvents EmployeeTimelineEvent[]
  documents    EmployeeDocument[]
  employeeSkills EmployeeSkill[]
  shiftAssignments EmployeeShiftAssignment[]
  attendanceRecords AttendanceRecord[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  employeeSalaries EmployeeSalary[]
  payrollItems     PayrollItem[]
  payrollAdjustments PayrollAdjustment[]
  payslips         Payslip[]
  employeeLoans    EmployeeLoan[]
  candidateProfile Candidate?
  onboardingRecords OnboardingRecord[]
  onboardingPlans   OnboardingPlan[]
  enrollments       EmployeeEnrollment[]
  trainingCertificates TrainingCertificate[]
  goals             Goal[]
  performanceReviews PerformanceReview[]
  developmentPlans  DevelopmentPlan[]
  trainingAssignments TrainingAssignment[]
  skillAssessments    EmployeeSkillAssessment[]
  skillGaps           SkillGap[]
  workforceRisks      WorkforceRisk[]

  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, email])
  @@index([organizationId, employmentStatus])
  @@index([organizationId, departmentId])
  @@index([organizationId, managerId])
  @@index([organizationId, lastName, firstName])
  @@map("employees")
}

model EmployeeTimelineEvent {
  id             String            @id @default(cuid())
  organizationId String
  employeeId     String
  eventType      TimelineEventType
  title          String
  description    String?
  metadata       Json?
  occurredAt     DateTime          @default(now())
  createdByUserId String?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("TimelineCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId, occurredAt])
  @@map("employee_timeline_events")
}

model EmployeeDocument {
  id               String             @id @default(cuid())
  organizationId   String
  employeeId       String
  name             String
  type             String
  fileUrl          String
  storageKey       String?
  uploadedByUserId String?
  uploadedAt       DateTime           @default(now())
  expiresAt        DateTime?
  visibility       DocumentVisibility @default(HR_ONLY)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId])
  @@map("employee_documents")
}

model SkillCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skills       Skill[]

  @@unique([organizationId, name])
  @@map("skill_categories")
}

model Skill {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String?
  name           String
  description    String?
  createdAt      DateTime @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       SkillCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  employeeSkills EmployeeSkill[]
  roleRequirements RoleSkillRequirement[]
  skillGaps        SkillGap[]
  assessments      EmployeeSkillAssessment[]

  @@unique([organizationId, name])
  @@map("skills")
}

model EmployeeSkill {
  id              String              @id @default(cuid())
  employeeId      String
  skillId         String
  proficiency     SkillProficiency
  yearsExperience Float?
  verified        Boolean             @default(false)
  source          EmployeeSkillSource @default(HR)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([employeeId, skillId])
  @@map("employee_skills")
}

model RoleSkillRequirement {
  id                   String           @id @default(cuid())
  organizationId       String
  profileName          String
  jobTitleId           String?
  skillId              String
  requiredProficiency  SkillProficiency
  createdAt            DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobTitle     JobTitle?    @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([organizationId, profileName, skillId])
  @@index([organizationId, profileName])
  @@map("role_skill_requirements")
}

model EmployeeSkillAssessment {
  id             String           @id @default(cuid())
  organizationId String
  employeeId     String
  skillId        String
  proficiency    SkillProficiency
  assessedAt     DateTime         @default(now())
  assessorUserId String?
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([organizationId, employeeId])
  @@map("employee_skill_assessments")
}

model SkillGap {
  id                   String           @id @default(cuid())
  organizationId       String
  employeeId           String
  skillId              String
  profileName          String
  requiredProficiency  SkillProficiency
  actualProficiency    SkillProficiency?
  gapLevels            Int              @default(0)
  detectedAt           DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill        Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([organizationId, employeeId, profileName])
  @@map("skill_gaps")
}

model WorkforceRisk {
  id             String                @id @default(cuid())
  organizationId String
  category       WorkforceRiskCategory
  severity       WorkforceRiskSeverity
  title          String
  summary        String
  ruleCode       String
  evidence       Json
  employeeId     String?
  departmentId   String?
  acknowledgedAt DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, category, severity])
  @@index([organizationId, ruleCode])
  @@map("workforce_risks")
}

model WorkforceInsight {
  id                String   @id @default(cuid())
  organizationId    String
  insightType       String
  title             String
  whatHappened      String
  whyItMatters      String
  recommendedAction String
  metrics           Json?
  departmentId      String?
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, insightType, createdAt])
  @@map("workforce_insights")
}

model ShiftTemplate {
  id                       String   @id @default(cuid())
  organizationId           String
  name                     String
  startTime                String
  endTime                  String
  breakDurationMinutes     Int      @default(0)
  workingDays              Json
  gracePeriodMinutes       Int      @default(0)
  overtimeThresholdMinutes Int      @default(0)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  EmployeeShiftAssignment[]
  attendanceRecords AttendanceRecord[]

  @@unique([organizationId, name])
  @@map("shift_templates")
}

model EmployeeShiftAssignment {
  id              String    @id @default(cuid())
  organizationId  String
  employeeId      String
  shiftTemplateId String
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  createdAt       DateTime  @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftTemplate ShiftTemplate @relation(fields: [shiftTemplateId], references: [id], onDelete: Restrict)

  @@index([organizationId, employeeId, effectiveFrom])
  @@map("employee_shift_assignments")
}

model AttendanceRecord {
  id                    String           @id @default(cuid())
  organizationId        String
  employeeId            String
  workDate              DateTime         @db.Date
  shiftTemplateId       String?
  status                AttendanceStatus @default(ABSENT)
  clockInAt             DateTime?
  clockOutAt            DateTime?
  workedMinutes         Int              @default(0)
  lateMinutes           Int              @default(0)
  overtimeMinutes       Int              @default(0)
  breakMinutes          Int              @default(0)
  earlyDepartureMinutes Int              @default(0)
  missingClockOut       Boolean          @default(false)
  notes                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftTemplate ShiftTemplate?      @relation(fields: [shiftTemplateId], references: [id], onDelete: SetNull)
  breaks       AttendanceBreak[]
  corrections  AttendanceCorrection[]

  @@unique([organizationId, employeeId, workDate])
  @@index([organizationId, workDate, status])
  @@map("attendance_records")
}

model AttendanceBreak {
  id                 String    @id @default(cuid())
  attendanceRecordId String
  startAt            DateTime
  endAt              DateTime?

