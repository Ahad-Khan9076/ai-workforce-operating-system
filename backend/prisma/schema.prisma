  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts     AssessmentAttempt[]

  @@unique([employeeId, courseId])
  @@index([organizationId, employeeId, status])
  @@map("employee_enrollments")
}

model TrainingCertificate {
  id                String            @id @default(cuid())
  organizationId    String
  employeeId        String
  courseId          String
  certificateNumber String
  issuedAt          DateTime          @default(now())
  expiresAt         DateTime?
  status            CertificateStatus @default(ACTIVE)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([organizationId, certificateNumber])
  @@index([organizationId, employeeId])
  @@map("training_certificates")
}

model PerformanceCycle {
  id             String                 @id @default(cuid())
  organizationId String
  name           String
  startDate      DateTime               @db.Date
  endDate        DateTime               @db.Date
  status         PerformanceCycleStatus @default(DRAFT)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goals        Goal[]
  reviews      PerformanceReview[]
  kpis         Kpi[]

  @@index([organizationId, status])
  @@map("performance_cycles")
}

model Goal {
  id             String     @id @default(cuid())
  organizationId String
  cycleId        String
  employeeId     String
  title          String
  description    String?
  target         String?
  weight         Float      @default(1)
  dueDate        DateTime?  @db.Date
  status         GoalStatus @default(DRAFT)
  progressPercent Float     @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle        PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, cycleId, employeeId])
  @@map("goals")
}

model Kpi {
  id             String  @id @default(cuid())
  organizationId String
  cycleId        String
  name           String
  description    String?
  targetValue    Float?
  unit           String?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle        PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId])
  @@map("kpis")
}

model PerformanceReview {
  id              String                  @id @default(cuid())
  organizationId  String
  cycleId         String
  employeeId      String
  managerId       String?
  status          PerformanceReviewStatus @default(PENDING)
  managerSummary  String?
  employeeAckNote String?
  finalizedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cycle        PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  feedback     PerformanceFeedback[]

  @@unique([cycleId, employeeId])
  @@index([organizationId, status])
  @@map("performance_reviews")
}

model Competency {
  id             String @id @default(cuid())
  organizationId String
  name           String
  description    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("competencies")
}

model PerformanceFeedback {
  id             String   @id @default(cuid())
  organizationId String
  reviewId       String
  authorUserId   String?
  body           String
  rating         Float?
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  review       PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("performance_feedbacks")
}

model DevelopmentPlan {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  cycleId        String?
  title          String
  focusAreas     Json     @default("[]")
  actions        Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, employeeId])
  @@map("development_plans")
}

model WorkforceInsightSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String?
  snapshotType   String
  payload        Json
  capturedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, snapshotType, capturedAt])
  @@map("workforce_insight_snapshots")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model OrganizationInvitation {
  id              String           @id @default(cuid())
  organizationId  String
  email           String
  roleId          String
  invitedByUserId String
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedUserId  String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedUser User?        @relation("InvitationAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, email, status])
  @@map("organization_invitations")
}

model Plan {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  limits      Json
  priceCents  Int      @default(0)
  currency    String   @default("USD")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
  items         SubscriptionItem[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  externalCustomerId String?
  externalSubscriptionId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  items        SubscriptionItem[]
  invoices     Invoice[]

  @@index([organizationId, status])
  @@map("subscriptions")
}

model SubscriptionItem {
  id             String   @id @default(cuid())
  subscriptionId String
  planId         String
  quantity       Int      @default(1)
  metadata       Json?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("subscription_items")
}

model UsageRecord {
  id             String          @id @default(cuid())
  organizationId String
  metric         UsageMetricCode
  quantity       Float
  recordedAt     DateTime        @default(now())
  periodStart    DateTime?
  periodEnd      DateTime?
  metadata       Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, metric, recordedAt])
  @@map("usage_records")
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  subscriptionId String?
  status         InvoiceStatus @default(DRAFT)
  amountCents    Int
  currency       String        @default("USD")
  externalInvoiceId String?
  issuedAt       DateTime?
  paidAt         DateTime?
  lineItems      Json          @default("[]")
  createdAt      DateTime      @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@map("invoices")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model AiModel {
  id             String   @id @default(cuid())
  organizationId String?
  providerCode   String
  modelName      String
  displayName    String
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations AiConversation[]

  @@unique([providerCode, modelName, organizationId])
  @@map("ai_models")
}

model AiTool {
  id                   String   @id @default(cuid())
  organizationId       String?
  code                 String
  description          String
  requiresConfirmation Boolean  @default(false)
  requiredPermissions  Json     @default("[]")
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  toolCalls    AiToolCall[]

  @@unique([code, organizationId])
  @@map("ai_tools")
}

model AiConversation {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  mode           CopilotMode
  title          String?
  modelId        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  model           AiModel?          @relation(fields: [modelId], references: [id], onDelete: SetNull)
  messages        AiMessage[]
  recommendations AiRecommendation[]
  actions         AiAction[]
  auditLogs       AiAuditLog[]

  @@index([organizationId, userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AiMessageRole
  content        String
  metadata       Json?
  createdAt      DateTime      @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolCalls    AiToolCall[]
  recommendations AiRecommendation[]

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiToolCall {
  id             String           @id @default(cuid())
  messageId      String
  toolId         String?
  toolCode       String
  arguments      Json
  result         Json?
  status         AiToolCallStatus @default(PENDING)
  errorMessage   String?
  createdAt      DateTime         @default(now())

  message AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  tool    AiTool?   @relation(fields: [toolId], references: [id], onDelete: SetNull)
  action  AiAction?

  @@index([toolCode, createdAt])
  @@map("ai_tool_calls")
}

model AiRecommendation {
  id             String   @id @default(cuid())
  organizationId String
  conversationId String
  messageId      String?
  title          String
  body           String
  dataRefs       Json?
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      AiMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([organizationId, conversationId])
  @@map("ai_recommendations")
}

model AiAction {
  id             String         @id @default(cuid())
  organizationId String
  conversationId String
  toolCallId     String?        @unique
  toolCode       String
  payload        Json
  status         AiActionStatus @default(PENDING)
  summary        String
  result         Json?
  errorMessage   String?
  confirmedAt    DateTime?
  executedAt     DateTime?
  createdAt      DateTime       @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolCall     AiToolCall?    @relation(fields: [toolCallId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("ai_actions")
}

model AiAuditLog {
  id             String   @id @default(cuid())
  organizationId String
  conversationId String?
  userId         String?
  toolCode       String?
  actionType     String
  success        Boolean
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("ai_audit_logs")
}

model RecommendationRule {
  id             String             @id @default(cuid())
  organizationId String?
  code           String
  type           RecommendationType
  name           String
  description    String
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]

  @@unique([code, organizationId])
  @@map("recommendation_rules")
}

model Recommendation {
  id                String                 @id @default(cuid())
  organizationId    String
  ruleId            String?
  ruleCode          String
  type              RecommendationType
  status            RecommendationStatus   @default(OPEN)
  priority          RecommendationPriority @default(MEDIUM)
  title             String
  whatHappened      String
  evidence          Json
  whyItMatters      String
  recommendedAction String
  confidenceScore   Float?
  confidenceNote    String?
  dedupeKey         String
  departmentId      String?
  expiresAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         RecommendationRule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  department   Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  actions      RecommendationAction[]
  feedback     RecommendationFeedback[]

  @@unique([organizationId, ruleCode, dedupeKey])
  @@index([organizationId, status, priority])
  @@map("recommendations")
}

model RecommendationAction {
  id               String                     @id @default(cuid())
  organizationId   String
  recommendationId String
  status           RecommendationActionStatus @default(PENDING)
  title            String
  description      String
  source           String
  priority         RecommendationPriority     @default(MEDIUM)
  recommendedAction String
  resolvedByUserId String?
  resolvedAt       DateTime?
  result           Json?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  resolvedBy     User?          @relation("RecommendationActionResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("recommendation_actions")
}

model RecommendationFeedback {
  id               String   @id @default(cuid())
  organizationId   String
  recommendationId String
  userId           String
  isHelpful        Boolean
  comment          String?
  createdAt        DateTime @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recommendationId, userId])
  @@map("recommendation_feedbacks")
}

model AutomationRule {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String
  triggerEvent   String
  actionType     String
  enabled        Boolean  @default(true)
  config         Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs    AutomationAuditLog[]

  @@unique([organizationId, code])
  @@map("automation_rules")
}

model AutomationAuditLog {
  id               String              @id @default(cuid())
  organizationId   String
  automationRuleId String?
  trigger          String
  ruleCode         String
  action           String
  actorType        AutomationActorType
  actorUserId      String?
  success          Boolean
  metadata         Json?
  createdAt        DateTime            @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automationRule AutomationRule? @relation(fields: [automationRuleId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("automation_audit_logs")
}

model Notification {
  id             String             @id @default(cuid())
  organizationId String
  userId         String
  channel        NotificationChannel
  title          String
  body           String
  readAt         DateTime?
  metadata       Json?
  createdAt      DateTime           @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@index([organizationId, userId, readAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  notificationId String
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  errorMessage   String?
  attemptedAt    DateTime?
  createdAt      DateTime                   @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, channel])
  @@map("notification_deliveries")
}
