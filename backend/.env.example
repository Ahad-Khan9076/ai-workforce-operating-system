NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api
API_DEFAULT_VERSION=1

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hr_workforce?schema=public

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_URL=redis://localhost:6379

OPENAI_API_KEY=

CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
INVITATION_TTL_DAYS=7

# Billing (Stripe — optional in development)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Rate limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# Observability (optional)
SENTRY_DSN=
LOG_LEVEL=info

# Demo login (created by npm run db:seed — development only)
# SEED_DEMO=false
# DEMO_USER_EMAIL=demo@hrworkforce.local
# DEMO_USER_PASSWORD=DemoOwner1
